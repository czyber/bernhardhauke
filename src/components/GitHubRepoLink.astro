---
import { Star } from "@lucide/astro";

interface Props {
  href: string;
  showStars?: boolean;
}

const { href, showStars = false } = Astro.props;
const match = href.match(/github\.com\/([^/]+)\/([^/#?]+)/);
const owner = match?.[1] ?? "";
const repo = match?.[2] ?? "";
const label = owner && repo ? `${owner}/${repo}` : "GitHub";
---

<a
  class="button button-secondary github-link"
  href={href}
  data-github-stars={showStars && owner && repo
    ? `${owner}/${repo}`
    : undefined}
>
  <svg
    class="github-link-icon"
    viewBox="0 0 24 24"
    aria-hidden="true"
    focusable="false"
  >
    <path
      fill="currentColor"
      d="M12 2C6.48 2 2 6.59 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49v-1.9c-2.78.62-3.37-1.21-3.37-1.21-.45-1.19-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.9 1.56 2.35 1.11 2.92.85.09-.66.35-1.11.63-1.37-2.22-.26-4.55-1.14-4.55-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05A9.3 9.3 0 0 1 12 7c.85 0 1.7.12 2.5.34 1.9-1.33 2.74-1.05 2.74-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.8-4.57 5.05.36.32.68.94.68 1.9v2.79c0 .27.18.59.69.49A10.18 10.18 0 0 0 22 12.25C22 6.59 17.52 2 12 2Z"
    ></path>
  </svg>
  <span>{label}</span>
  {
    showStars && owner && repo && (
      <span class="github-stars" aria-label="GitHub stars" hidden>
        <Star size={13} stroke-width={1.8} aria-hidden="true" />
        <span data-github-stars-count />
      </span>
    )
  }
</a>

<script>
  const formatter = new Intl.NumberFormat("en", {
    notation: "compact",
    maximumFractionDigits: 1,
  });

  document
    .querySelectorAll<HTMLAnchorElement>("[data-github-stars]")
    .forEach(async (link) => {
      const repo = link.dataset.githubStars;
      const count = link.querySelector("[data-github-stars-count]");

      if (!repo || !count) return;

      try {
        const response = await fetch(`https://api.github.com/repos/${repo}`, {
          headers: { Accept: "application/vnd.github+json" },
        });
        if (!response.ok) return;

        const data = (await response.json()) as {
          stargazers_count?: number;
        };
        if (typeof data.stargazers_count !== "number") return;

        count.textContent = formatter.format(data.stargazers_count);
        count.closest(".github-stars")?.removeAttribute("hidden");
      } catch {
        // Keep the link quiet when GitHub is unavailable.
      }
    });
</script>
