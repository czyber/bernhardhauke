---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
---

<article class="project-row">
  <a class="project-row-link" href={`/projects/${project.id}/`}>
    <span class="project-row-copy">
      <h3 class="project-row-title">{project.data.title}</h3>
      <span class="project-row-description">{project.data.description}</span>
      {
        project.data.stack.length > 0 && (
          <span class="project-row-stack" aria-label="Project stack">
            {project.data.stack.join(" / ")}
          </span>
        )
      }
    </span>
    <span class="project-row-status">
      {project.data.year} / {project.data.status}
    </span>
  </a>
</article>
