<div class="interactive-grid" aria-hidden="true"></div>

<script>
  const root = document.documentElement;

  if (!root.dataset.pointerGridReady) {
    root.dataset.pointerGridReady = "true";

    let scrollStop: "" | "top" | "bottom" = "";
    let scrollStopTimer = 0;

    const pulseScrollStop = (stop: "top" | "bottom") => {
      root.dataset.scrollStop = stop;

      window.clearTimeout(scrollStopTimer);
      scrollStopTimer = window.setTimeout(() => {
        delete root.dataset.scrollStop;
      }, 220);
    };

    const updateScrollInstrument = ({ pulse = true } = {}) => {
      const shell = document.querySelector(".site-shell");
      const scrollable =
        document.documentElement.scrollHeight - window.innerHeight;
      const progress =
        scrollable > 0
          ? Math.min(Math.max(window.scrollY / scrollable, 0), 1)
          : 0;

      root.style.setProperty("--scroll-progress", progress.toFixed(4));
      root.style.setProperty(
        "--scroll-marker-opacity",
        (0.52 + progress * 0.14).toFixed(3),
      );

      if (shell) {
        const rulerStart = 112;
        const rulerEnd = 96;
        const track = Math.max(shell.clientHeight - rulerStart - rulerEnd, 0);
        root.style.setProperty(
          "--scroll-ruler-y",
          `${Math.round(rulerStart + track * progress)}px`,
        );
      }

      const edgeThreshold =
        scrollable > 0 ? Math.min(0.012, 12 / scrollable) : 0;
      const nextScrollStop =
        progress <= edgeThreshold
          ? "top"
          : progress >= 1 - edgeThreshold
            ? "bottom"
            : "";

      if (pulse && nextScrollStop && nextScrollStop !== scrollStop) {
        pulseScrollStop(nextScrollStop);
      }

      scrollStop = nextScrollStop;
    };

    let scrollFrame = 0;
    const requestScrollInstrumentUpdate = () => {
      if (scrollFrame) return;

      scrollFrame = window.requestAnimationFrame(() => {
        scrollFrame = 0;
        updateScrollInstrument();
      });
    };

    window.addEventListener(
      "pointermove",
      (event) => {
        root.style.setProperty("--pointer-x", `${event.clientX}px`);
        root.style.setProperty("--pointer-y", `${event.clientY}px`);
        root.dataset.pointerActive = "true";
      },
      { passive: true },
    );

    window.addEventListener("pointerleave", () => {
      root.dataset.pointerActive = "false";
    });

    updateScrollInstrument({ pulse: false });
    window.addEventListener("scroll", requestScrollInstrumentUpdate, {
      passive: true,
    });
    window.addEventListener("resize", requestScrollInstrumentUpdate);
  }
</script>
