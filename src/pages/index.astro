---
import { getCollection } from "astro:content";
import ArticleIndexItem from "../components/ArticleIndexItem.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const statusRank = {
  Active: 0,
  Shipped: 1,
  Exploring: 2,
  Archived: 3,
};

const allProjects = (await getCollection("projects"))
  .filter((project) => !project.data.draft)
  .sort(
    (a, b) =>
      Number(b.data.featured) - Number(a.data.featured) ||
      statusRank[a.data.status] - statusRank[b.data.status] ||
      b.data.year - a.data.year ||
      a.data.title.localeCompare(b.data.title),
  );

const articles = (await getCollection("articles"))
  .filter((article) => !article.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout>
  <section class="home-opening" aria-labelledby="home-title">
    <div class="home-introduction">
      <h1 id="home-title">
        A focused place for what I am<br class="wide-break" /> building and learning.
      </h1>
      <p>A curious mind, exploring the landscape of software.</p>
    </div>
    <a class="home-continue" href="#recent-writing"
      >Writing &amp; projects <span aria-hidden="true">↓</span></a
    >
  </section>

  <div class="home-notes">
    <section class="section-stack" id="recent-writing">
      <div class="section-row">
        <SectionHeading title="Recent writing" />
        <a class="text-link" href="/articles/">All articles</a>
      </div>
      <div class="article-index article-index--compact">
        {
          articles
            .slice(0, 4)
            .map((article) => <ArticleIndexItem article={article} />)
        }
      </div>
    </section>

    <section class="section-stack" data-animate style="--delay: 80ms">
      <div class="section-row">
        <SectionHeading title="Selected work" />
        <a class="text-link" href="/projects/">All projects</a>
      </div>
      <div class="card-grid">
        {
          allProjects
            .slice(0, 2)
            .map((project) => <ProjectCard project={project} />)
        }
      </div>
    </section>

    <section class="home-personal text-block">
      <p>
        This is a collection of my journey, exploring the fascinating realms of
        software and engineering. For me, educating myself is sparked by
        curiosity and impulse, all over the place.
      </p>
      <p>
        I deeply believe in giving in to the process and enjoying it. No matter
        if it "makes sense".
      </p>
      <a class="text-link" href="/about/">More about me</a>
    </section>
  </div>
</BaseLayout>

<style>
  .home-opening {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: start center;
    min-height: min(760px, calc(100svh - 110px));
    margin-top: -32px;
    padding-top: clamp(90px, 16vh, 180px);
    overflow: hidden;
  }

  .home-introduction {
    position: relative;
    z-index: 1;
    text-align: center;
  }
  .home-introduction h1 {
    max-width: 30ch;
    margin: 0 auto;
    font-family: var(--font-title);
    font-size: clamp(30px, 3.3vw, 44px);
    font-weight: 400;
    font-style: italic;
    line-height: 1.18;
    text-wrap: balance;
  }
  .home-introduction p {
    margin: 24px 0 0;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.5;
  }
  .home-continue {
    position: absolute;
    bottom: 20px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
  }
  .home-continue span {
    margin-left: 12px;
  }
  .home-continue:hover {
    color: var(--text);
  }
  .home-notes {
    max-width: 800px;
    margin: 64px auto 0;
  }
  .home-notes :global(.section-stack) {
    margin-top: 88px;
  }
  #recent-writing {
    scroll-margin-top: 48px;
  }
  .home-notes :global(.section-heading h2) {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 20px;
    font-weight: 400;
    color: var(--muted);
  }
  .home-notes :global(.section-row > a) {
    font-family: var(--font-mono);
    font-size: 11px;
  }
  .home-notes :global(.article-index-item) {
    border: 0;
  }
  .home-notes :global(.article-index-link) {
    padding: 10px 0;
    align-items: baseline;
  }
  .home-notes :global(.article-index-title) {
    font-size: 23px;
    font-style: italic;
    font-weight: 400;
  }
  .home-notes :global(.article-index-description) {
    display: none;
  }
  .home-notes :global(.article-index-date) {
    color: var(--muted);
  }
  .home-notes :global(.project-row-title) {
    font-style: italic;
    font-weight: 400;
  }
  .home-personal {
    max-width: 590px;
    margin-top: 96px;
  }
  .home-personal > a {
    display: inline-block;
    margin-top: 16px;
  }
  @media (max-width: 760px) {
    .home-opening {
      min-height: 620px;
      margin-top: -24px;
      padding-top: 96px;
    }
    .home-introduction p {
      max-width: 27ch;
      margin-inline: auto;
    }
    .wide-break {
      display: none;
    }
    .home-notes {
      margin-top: 40px;
    }
    .home-notes :global(.section-row) {
      flex-direction: row;
      align-items: baseline;
    }
    .home-notes :global(.article-index-link) {
      gap: 4px;
      padding: 14px 0;
    }
    .home-notes :global(.article-index-title) {
      font-size: 23px;
    }
  }
</style>
