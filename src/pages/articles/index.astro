---
import { getCollection } from "astro:content";
import ArticleIndexItem from "../../components/ArticleIndexItem.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const articles = (await getCollection("articles"))
  .filter((article) => !article.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Articles"
  description="Articles and notes by Bernhard Hauke."
>
  <section class="page-intro" data-animate>
    <h1>Articles</h1>
  </section>

  <section class="article-index" data-animate style="--delay: 80ms">
    {articles.map((article) => <ArticleIndexItem article={article} />)}
  </section>
</BaseLayout>
