---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

interface Props {
  article: CollectionEntry<"articles">;
}

export async function getStaticPaths() {
  const articles = (await getCollection("articles")).filter(
    (article) => !article.data.draft,
  );

  return articles.map((article) => ({
    params: { id: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const date = article.data.pubDate.toLocaleDateString("en", {
  month: "long",
  day: "numeric",
  year: "numeric",
});
---

<BaseLayout
  title={article.data.title}
  description={article.data.description}
  socialDescription={article.data.socialDescription}
  image={article.data.socialImage}
  type="article"
  canonicalPath={`/articles/${article.id}/`}
  publishedTime={article.data.pubDate.toISOString()}
  modifiedTime={(
    article.data.updatedDate ?? article.data.pubDate
  ).toISOString()}
  tags={article.data.tags}
>
  <article
    class="article-page article-page--reading"
    data-animate
    data-analytics-article
  >
    <header class="article-header">
      <a class="back-link" href="/articles/">Articles</a>
      <p class="eyebrow">{date}</p>
      <h1>{article.data.title}</h1>
      <p>{article.data.description}</p>
      {
        article.data.tags.length > 0 && (
          <p class="article-tags">
            <span>Filed under</span> {article.data.tags.join(" / ")}
          </p>
        )
      }
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<script>
  import "../../components/MeaningAcrossLayers";

  if (document.querySelector("token-loop, sampling-comparison")) {
    import("../../components/GenerationExamples");
  }
</script>

<style is:global>
  .article-page--reading .prose:has(token-loop) {
    hyphens: none;
  }

  .prose token-loop,
  .prose sampling-comparison {
    display: block;
    margin-block: 28px;
  }

  .prose .generation-equation {
    margin-block: 28px;
    overflow-x: auto;
    padding-block: 8px;
    color: var(--text);
  }

  .prose .generation-equation math {
    font-size: 1.15em;
  }

  .prose .generation-reproduction {
    border-top: 1px solid var(--border);
    margin-top: 36px;
    padding-top: 20px;
    font-size: 0.85em;
    line-height: 1.6;
  }
</style>
